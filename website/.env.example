# Auth/game API root. Leave blank to use the website same-origin /api proxy.
# The website will call:
# - POST /api/v1/auth/login
# - POST /api/v1/auth/signup
# - GET  /api/v1/auth/google
NEXT_PUBLIC_AUTH_API_BASE_URL=

# Game endpoints used by the website lobby. Leave blank to use the same proxy.
NEXT_PUBLIC_GAME_API_BASE_URL=

# Game handoff target.
NEXT_PUBLIC_GAME_CLIENT_URL=/game

# Fallback used by older code paths if NEXT_PUBLIC_AUTH_API_BASE_URL is not set.
NEXT_PUBLIC_API_BASE_URL=
